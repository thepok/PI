digraph RA0002Frontier {
  graph [rankdir=LR, labelloc=t,
         label="RA-0002: exact sufficient-condition frontier to canonical V1"];
  node [shape=box, fontname="Helvetica"];
  edge [fontname="Helvetica"];

  V1 [label="canonical V1\nT7"];
  C1 [label="C1\nT1"];
  T19 [label="PiNaturalScaleCancellationExact\nopen for pi"];
  PTD [label="PowerTenDiophantine pi mu A\nexternal/open"];
  U17 [label="eventual exact T17 aggregate upper bound\nopen"];
  GP2 [label="GP-0002 contrapositive package\nbounded formal target"];
  A28 [label="T28 additive gap\nmoving >= q/16 frequency set"];
  AR [label="uniform appearance ratio\nL_m <= C p_pi(m)\nopen"];
  A29 [label="T29 fixed relative gap\nmoving frequency set"];
  ENT [label="maximal factor entropy\nT30"];
  DENSE [label="Dense ten/sixteen orbit\nexternal premise"];
  RET [label="FixedSixteenReturn\nopen"];
  BBP [label="T104-T106\nBBP identity and forced orbit"];
  BW [label="sampled-BBP Weyl cancellation\nopen"];
  BD [label="sampled-BBP arbitrarily-late circle density\nopen"];
  PKG [label="T109 eventual symbolic packaging\nconditional"];
  SRC [label="IrrationalityMeasureBelow pi 8\nexternal premise"];
  COV [label="all prescribed BBP codes recur arbitrarily late\nopen"];
  A1 [label="positive lower block density\nopen"];
  COLL [label="long-lag collision decay\nopen"];

  T19 -> V1 [label="machine-checked T19"];
  PTD -> GP2 [style=dashed, label="premise"];
  U17 -> GP2 [style=dashed, label="premise"];
  GP2 -> C1 [style=dotted, label="to formalize"];
  C1 -> V1 [label="machine-checked T1"];

  A28 -> A29 [label="machine-checked T29\nconditional"];
  AR -> A29 [style=dashed, label="open premise"];
  A29 -> ENT [style=dotted, label="no sufficient edge"];
  ENT -> V1 [dir=both, label="machine-checked T30"];

  DENSE -> RET [style=dashed, label="needed for reverse"];
  RET -> V1 [label="machine-checked T69\nunder DENSE"];
  V1 -> RET [label="machine-checked T69"];

  BBP -> BW [label="machine-checked T107 transfer"];
  BW -> V1 [label="machine-checked T107"];
  BBP -> BD [label="machine-checked T108 transfer"];
  BD -> V1 [dir=both, label="machine-checked T108"];
  BBP -> PKG [label="machine-checked T109"];
  SRC -> PKG [style=dashed, label="explicit premise"];
  PKG -> COV [style=dotted, label="identification only"];
  COV -> V1 [style=dashed, label="missing occurrence input"];

  COLL -> A1 [label="machine-checked"];
  A1 -> V1 [label="machine-checked"];
}
