import TheoryLib.PiPositiveDecimalFactorEntropy.T56T56LagSectorAudit
import TheoryLib.PiLongLagBlockCollisionDecay.T16T16FiniteWeightedGCD

/-!
# T58: triangular Fejer arithmetic audit

Source: `problems/local/pi-positive-decimal-factor-entropy.txt`
SHA-256: `a70dd741b27595aeb3dfc902b5e201579fed6bae24e2191f58c5ac64a22939e6`

This file imports T56's checked short-sector predicate but does not assert it.
It checks only the finite arithmetic and diagonal/off-diagonal bookkeeping used
by the T58 note.  In particular it proves no estimate at `Real.pi` and no
instance of C7, C2, or C1.
-/

noncomputable section

open Finset
open scoped BigOperators

namespace DecimalFactorComplexity.T58TriangularFejerAudit

open DecimalFactorComplexity.T56LagSectorAudit
open Theory.PiDigits.LongLagBlockCollisionDecay.T16

/-- T56's sample length, exposed locally without changing its definition. -/
abbrev sampleLength (n : ℕ) : ℕ := t56SampleLength n

/-- T56/T27's exact bandwidth `H_n = 10^n/2`. -/
def bandwidth (n : ℕ) : ℕ := 10 ^ n / 2

/-- Positive half of the strict Fejer band. -/
def positiveFejerFrequencies (n : ℕ) : Finset ℕ :=
  Finset.Ico 1 (bandwidth n)

/-- The triangular short-lag rectangle, represented as `(r,j)`. -/
def shortRectangle (n : ℕ) : Finset (ℕ × ℕ) :=
  ((Finset.range n).product (Finset.range (sampleLength n))).filter fun p =>
    0 < p.1 ∧ p.2 < sampleLength n - p.1

/-- The positive integer frequency generated by `(h,j,r)`. -/
def phi (h j r : ℕ) : ℕ := h * 10 ^ j * (10 ^ r - 1)

/-- The positive triangular Fejer weight. -/
def positiveFejerWeight (n h : ℕ) : ℝ :=
  1 - (h : ℝ) / (bandwidth n : ℝ)

theorem mem_positiveFejerFrequencies_iff {n h : ℕ} :
    h ∈ positiveFejerFrequencies n ↔ 0 < h ∧ h < bandwidth n := by
  simp only [positiveFejerFrequencies, Finset.mem_Ico]
  omega

theorem mem_shortRectangle_iff {n r j : ℕ} :
    (r, j) ∈ shortRectangle n ↔
      0 < r ∧ r < n ∧ j < sampleLength n - r := by
  constructor
  · intro h
    rw [shortRectangle, Finset.mem_filter] at h
    have hp := Finset.mem_product.mp h.1
    exact ⟨h.2.1, Finset.mem_range.mp hp.1, h.2.2⟩
  · rintro ⟨hr, hrn, hj⟩
    have hjL : j < sampleLength n :=
      hj.trans_le (Nat.sub_le (sampleLength n) r)
    rw [shortRectangle, Finset.mem_filter]
    exact ⟨Finset.mem_product.mpr
      ⟨Finset.mem_range.mpr hrn, Finset.mem_range.mpr hjL⟩, hr, hj⟩

theorem phi_eq_frequency_mul_structuredDenominator (h j r : ℕ) :
    phi h j r = h * Theory.PiDigits.PositiveLowerBlockDensity.T25.structuredDenominator j r := by
  unfold phi Theory.PiDigits.PositiveLowerBlockDensity.T25.structuredDenominator
  ring

/-- For a fixed positive multiplier, the `(j,r)` decimal frequency is
injective on positive lags. -/
theorem phi_fixed_h_injective
    {h j₁ r₁ j₂ r₂ : ℕ} (hh : 0 < h) (hr₁ : 0 < r₁) (hr₂ : 0 < r₂)
    (heq : phi h j₁ r₁ = phi h j₂ r₂) :
    j₁ = j₂ ∧ r₁ = r₂ := by
  have hdenom :
      Theory.PiDigits.PositiveLowerBlockDensity.T25.structuredDenominator j₁ r₁ =
        Theory.PiDigits.PositiveLowerBlockDensity.T25.structuredDenominator j₂ r₂ := by
    rw [phi_eq_frequency_mul_structuredDenominator,
      phi_eq_frequency_mul_structuredDenominator] at heq
    exact Nat.eq_of_mul_eq_mul_left hh heq
  have hv₁ := cancellationValue_ten_reduction j₁ r₁ hr₁
  have hv₂ := cancellationValue_ten_reduction j₂ r₂ hr₂
  have hj : j₁ = j₂ := by
    have hv := congrArg tenValuation hdenom
    simpa [Theory.PiDigits.PositiveLowerBlockDensity.T25.structuredDenominator,
      hv₁.1, hv₂.1] using hv
  subst j₂
  have hrep : 10 ^ r₁ - 1 = 10 ^ r₂ - 1 := by
    unfold Theory.PiDigits.PositiveLowerBlockDensity.T25.structuredDenominator at hdenom
    exact Nat.eq_of_mul_eq_mul_left (pow_pos (by norm_num : 0 < 10) j₁) hdenom
  have hpowers : 10 ^ r₁ = 10 ^ r₂ := by
    calc
      10 ^ r₁ = (10 ^ r₁ - 1) + 1 :=
        (Nat.sub_add_cancel (one_le_pow₀ (by norm_num))).symm
      _ = (10 ^ r₂ - 1) + 1 := by rw [hrep]
      _ = 10 ^ r₂ := Nat.sub_add_cancel (one_le_pow₀ (by norm_num))
  exact ⟨rfl, Nat.pow_right_injective (by norm_num : 1 < 10) hpowers⟩

/-- Exact factorization after removing the maximal power of ten from the
frequency multiplier. -/
theorem phi_eq_ten_reduced (h j r : ℕ) :
    phi h j r =
      10 ^ (tenValuation h + j) *
        (tenPrimitivePart h * (10 ^ r - 1)) := by
  unfold phi
  calc
    h * 10 ^ j * (10 ^ r - 1) =
        (10 ^ tenValuation h * tenPrimitivePart h) * 10 ^ j *
          (10 ^ r - 1) := by rw [ten_reduction]
    _ = 10 ^ (tenValuation h + j) *
          (tenPrimitivePart h * (10 ^ r - 1)) := by
      rw [pow_add]
      ring

/-- A collision after explicitly removing the maximal powers of ten from both
frequency multipliers.  This is an exact algebraic equivalence, with no
prime-valuation shortcut for the composite base ten. -/
theorem phi_collision_after_ten_reduction
    {h₁ h₂ j₁ r₁ j₂ r₂ : ℕ} :
    phi h₁ j₁ r₁ = phi h₂ j₂ r₂ ↔
      10 ^ (tenValuation h₁ + j₁) *
          (tenPrimitivePart h₁ * (10 ^ r₁ - 1)) =
        10 ^ (tenValuation h₂ + j₂) *
          (tenPrimitivePart h₂ * (10 ^ r₂ - 1)) := by
  rw [phi_eq_ten_reduced, phi_eq_ten_reduced]

/-- Algebraic collision mass for a finite weighted frequency family. -/
def collisionSecondMoment {ι : Type*} [DecidableEq ι]
    (s : Finset ι) (frequency : ι → ℕ) (weight : ι → ℝ) : ℝ :=
  ∑ x ∈ s, ∑ y ∈ s,
    if frequency x = frequency y then weight x * weight y else 0

/-- Exact diagonal part of the collision second moment. -/
def diagonalSecondMoment {ι : Type*} [DecidableEq ι]
    (s : Finset ι) (weight : ι → ℝ) : ℝ :=
  ∑ x ∈ s, weight x ^ 2

/-- Exact off-diagonal equal-frequency part. -/
def offDiagonalSecondMoment {ι : Type*} [DecidableEq ι]
    (s : Finset ι) (frequency : ι → ℕ) (weight : ι → ℝ) : ℝ :=
  ∑ x ∈ s, ∑ y ∈ s.erase x,
    if frequency x = frequency y then weight x * weight y else 0

/-- The collision second moment splits exactly into its diagonal and
off-diagonal equal-frequency terms. -/
theorem collisionSecondMoment_eq_diagonal_add_offDiagonal
    {ι : Type*} [DecidableEq ι]
    (s : Finset ι) (frequency : ι → ℕ) (weight : ι → ℝ) :
    collisionSecondMoment s frequency weight =
      diagonalSecondMoment s weight +
        offDiagonalSecondMoment s frequency weight := by
  classical
  unfold collisionSecondMoment diagonalSecondMoment offDiagonalSecondMoment
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro x hx
  rw [← Finset.sum_erase_add _ _ hx]
  simp [pow_two]
  ring

end DecimalFactorComplexity.T58TriangularFejerAudit

