/-! ## Fixed-word limiting core and source premise -/

/-- The intersection of all endpoint-inclusive finite-depth cores for one
fixed decimal word. -/
def limitingCore (w : List (Fin 10)) : Set UnitAddCircle :=
  ⋂ R : ℕ, Core w R

/-- Multiplication by sixteen on the circle. -/
def timesSixteenPoint : UnitAddCircle → UnitAddCircle := circleMul 16

/-- The forward semigroup orbit with generators times ten and times sixteen.
Both exponents start at zero. -/
def tenSixteenOrbit (x : UnitAddCircle) : Set UnitAddCircle :=
  {y | ∃ s t : ℕ, y = circleMul (10 ^ s * 16 ^ t) x}

/-- The exact specialized source input used from Furstenberg (1967):

* Theorem IV.1 says a non-rational point has dense forward orbit under the
  nonlacunary semigroup generated by 10 and 16.
* Lemma IV.2 says a closed forward-invariant set whose zero is non-isolated is
  the whole circle.

This structure is a premise. No inhabitant is constructed in this file. -/
structure FurstenbergSourcePremise : Prop where
  orbit_dense_or_rational : ∀ x : UnitAddCircle,
    IsRationalCirclePoint x ∨ Dense (tenSixteenOrbit x)
  zero_accumulation_forces_univ : ∀ A : Set UnitAddCircle,
    IsClosed A →
    MapsTo timesTen A A →
    MapsTo timesSixteenPoint A A →
    AccPt 0 (𝓟 A) → A = Set.univ

/-- Increasing the inclusive depth by one permits one multiplication by 16. -/
theorem timesSixteen_core_succ_mapsTo (w : List (Fin 10)) (R : ℕ) :
    MapsTo timesSixteenPoint (Core w (R + 1)) (Core w R) := by
  rw [core_eq_finiteAvoidanceIntersection, core_eq_finiteAvoidanceIntersection]
  intro x hx j hj
  have h := hx (j + 1) (by omega)
  change circleMul (16 ^ j) (circleMul 16 x) ∈ KWord w
  rw [circleMul_comp]
  simpa [pow_succ, Nat.mul_comm, Nat.mul_assoc] using h

/-- The limiting core is closed, hence compact in the circle. -/
theorem limitingCore_isClosed (w : List (Fin 10)) :
    IsClosed (limitingCore w) := by
  exact isClosed_iInter fun R => core_isClosed w R

theorem limitingCore_isCompact (w : List (Fin 10)) :
    IsCompact (limitingCore w) :=
  (limitingCore_isClosed w).isCompact

/-- Forward times-ten invariance retains T44's direction convention. -/
theorem limitingCore_timesTen_mapsTo (w : List (Fin 10)) :
    MapsTo timesTen (limitingCore w) (limitingCore w) := by
  intro x hx
  have hx' : ∀ R : ℕ, x ∈ Core w R := by
    simpa [limitingCore] using hx
  have hout : ∀ R : ℕ, timesTen x ∈ Core w R := fun R =>
    core_forward_timesTen_invariant w R (hx' R)
  simpa [limitingCore] using hout

/-- Forward times-sixteen invariance follows from the one-depth inclusion. -/
theorem limitingCore_timesSixteen_mapsTo (w : List (Fin 10)) :
    MapsTo timesSixteenPoint (limitingCore w) (limitingCore w) := by
  intro x hx
  have hx' : ∀ R : ℕ, x ∈ Core w R := by
    simpa [limitingCore] using hx
  have hout : ∀ R : ℕ, timesSixteenPoint x ∈ Core w R := fun R =>
    timesSixteen_core_succ_mapsTo w R (hx' (R + 1))
  simpa [limitingCore] using hout

/-- The zero endpoints in the inclusive core definition put the limiting core
inside the endpoint-safe avoidance image `KWord`. -/
theorem limitingCore_subset_KWord (w : List (Fin 10)) :
    limitingCore w ⊆ KWord w := by
  intro x hx
  have hx' : ∀ R : ℕ, x ∈ Core w R := by
    simpa [limitingCore] using hx
  have hx0 : x ∈ Core w 0 := hx' 0
  rw [core_eq_finiteAvoidanceIntersection] at hx0
  simpa [finiteAvoidanceIntersection, circleMul] using hx0 0 (by omega)

/-! ## Endpoint-safe properness -/

/-- Every expansion of the center of the word cylinder starts with `w`.
The center is strictly away from both decimal endpoints, so the existential
two-expansion convention in `KWord` cannot evade the displayed occurrence. -/
theorem circleValue_eq_center_implies_occursAt_zero
    (w : List (Fin 10)) (b : DecimalStream)
    (hb : circleValue b = (decimalCylinderCenter w : UnitAddCircle)) :
    OccursAt w b 0 := by
  have hcenterPos : 0 < decimalCylinderCenter w := by
    linarith [decimalCylinderInnerRadius_pos w,
      decimalCylinderInnerRadius_lt_center w]
  have hcenterLt : decimalCylinderCenter w < 1 := by
    linarith [decimalCylinderInnerRadius_pos w,
      decimalCylinderInnerRadius_lt_one_sub_center w]
  have hbIcc : Real.ofDigits b ∈ Set.Icc (0 : ℝ) 1 :=
    ⟨Real.ofDigits_nonneg b, Real.ofDigits_le_one b⟩
  have hcIcc : decimalCylinderCenter w ∈ Set.Icc (0 : ℝ) 1 :=
    ⟨hcenterPos.le, hcenterLt.le⟩
  have hreal : Real.ofDigits b = decimalCylinderCenter w := by
    have hcircle : ((Real.ofDigits b : ℝ) : UnitAddCircle) =
        ((decimalCylinderCenter w : ℝ) : UnitAddCircle) := hb
    rcases
        (MultiplicativeAvoidanceGap.T13.unitAddCircle_eq_iff_endpointEq
          hbIcc hcIcc).mp hcircle with
      heq | ⟨hb0, hc1⟩ | ⟨hb1, hc0⟩
    · exact heq
    · exfalso
      linarith
    · exfalso
      linarith
  let p := DecimalFactorComplexity.NormalOrbitNearReturns.prefixLabel b w.length 0
  let q := Theory.PiDigits.T20.wordValue w
  have hcell :=
    DecimalFactorComplexity.NormalOrbitNearReturns.tailOrbit_mem_closedCell
      b w.length 0
  have hpq : p = q := by
    have hden : (0 : ℝ) < (10 : ℝ) ^ w.length := by positivity
    have hcell' : Real.ofDigits b ∈ Set.Icc
        ((p : ℝ) / (10 : ℝ) ^ w.length)
        (((p + 1 : ℕ) : ℝ) / (10 : ℝ) ^ w.length) := by
      simpa [p, DecimalFactorComplexity.NormalOrbitNearReturns.tailOrbit] using hcell
    rw [hreal] at hcell'
    have hcenter : decimalCylinderCenter w =
        (q : ℝ) / (10 : ℝ) ^ w.length +
          ((10 : ℝ) ^ w.length)⁻¹ / 2 := by
      rfl
    rw [hcenter] at hcell'
    have hp_le_q : p ≤ q := by
      have hrealLt : (p : ℝ) < (q : ℝ) + 1 := by
        simp only [div_eq_mul_inv] at hcell'
        have hinv : 0 < ((10 : ℝ) ^ w.length)⁻¹ := inv_pos.mpr hden
        nlinarith [hcell'.1]
      exact_mod_cast (Nat.lt_add_one_iff.mp (by exact_mod_cast hrealLt))
    have hq_le_p : q ≤ p := by
      have hrealLt : (q : ℝ) < (p : ℝ) + 1 := by
        simp only [div_eq_mul_inv] at hcell'
        have hinv : 0 < ((10 : ℝ) ^ w.length)⁻¹ := inv_pos.mpr hden
        by_contra hnot
        have hle : (p : ℝ) + 1 ≤ (q : ℝ) := le_of_not_gt hnot
        have hle' : ((p + 1 : ℕ) : ℝ) ≤ (q : ℝ) := by
          simpa using hle
        have hscaled := mul_le_mul_of_nonneg_right hle' hinv.le
        have hhalf : 0 < ((10 : ℝ) ^ w.length)⁻¹ * (2 : ℝ)⁻¹ := by positivity
        have himpossible := hcell'.2.trans hscaled
        nlinarith
      exact_mod_cast (Nat.lt_add_one_iff.mp (by exact_mod_cast hrealLt))
    exact Nat.le_antisymm hp_le_q hq_le_p
  have hpref :
      DecimalFactorComplexity.NormalOrbitNearReturns.prefixWord b w.length 0 = w := by
    apply Theory.PiDigits.DecimalBoundaryWordObstruction.wordValue_injective_of_length
    · simp [DecimalFactorComplexity.NormalOrbitNearReturns.prefixWord]
    · exact hpq
  intro i
  have hget := congrArg (fun l : List (Fin 10) => l[i.val]?) hpref
  simpa [DecimalFactorComplexity.NormalOrbitNearReturns.prefixWord, i.isLt] using hget

/-- `KWord w` is proper for every nonempty word, with decimal endpoints handled
by the existential expansion convention itself. -/
theorem KWord_ne_univ (w : List (Fin 10)) (hw : w ≠ []) :
    KWord w ≠ Set.univ := by
  by_cases hnil : w = []
  · exact (hw hnil).elim
  · intro hfull
    have hx : (decimalCylinderCenter w : UnitAddCircle) ∈ KWord w := by
      rw [hfull]
      trivial
    rcases hx with ⟨b, hbavoid, hbvalue⟩
    exact hbavoid 0 (circleValue_eq_center_implies_occursAt_zero w b hbvalue)

theorem limitingCore_ne_univ (w : List (Fin 10)) (hw : w ≠ []) :
    limitingCore w ≠ Set.univ := by
  intro hfull
  apply KWord_ne_univ w hw
  apply Set.eq_univ_of_univ_subset
  rw [← hfull]
  exact limitingCore_subset_KWord w

/-! ## Conditional Furstenberg finiteness -/

/-- Explicit difference set used to turn an infinite compact set into a
closed invariant set with zero as an accumulation point. -/
def differenceSet (A : Set UnitAddCircle) : Set UnitAddCircle :=
  (fun p : UnitAddCircle × UnitAddCircle => p.1 - p.2) '' (A ×ˢ A)

theorem differenceSet_isCompact {A : Set UnitAddCircle} (hA : IsCompact A) :
    IsCompact (differenceSet A) := by
  exact (hA.prod hA).image (continuous_fst.sub continuous_snd)

theorem differenceSet_timesTen_mapsTo {A : Set UnitAddCircle}
    (hA : MapsTo timesTen A A) :
    MapsTo timesTen (differenceSet A) (differenceSet A) := by
  rintro _ ⟨⟨x, y⟩, ⟨hx, hy⟩, rfl⟩
  refine ⟨(timesTen x, timesTen y), ⟨hA hx, hA hy⟩, ?_⟩
  simp only [timesTen, nsmul_sub]

theorem differenceSet_timesSixteen_mapsTo {A : Set UnitAddCircle}
    (hA : MapsTo timesSixteenPoint A A) :
    MapsTo timesSixteenPoint (differenceSet A) (differenceSet A) := by
  rintro _ ⟨⟨x, y⟩, ⟨hx, hy⟩, rfl⟩
  refine ⟨(timesSixteenPoint x, timesSixteenPoint y), ⟨hA hx, hA hy⟩, ?_⟩
  simp only [timesSixteenPoint, circleMul, nsmul_sub]

theorem zero_accPt_differenceSet_of_infinite_compact
    {A : Set UnitAddCircle} (hAcompact : IsCompact A) (hAinf : A.Infinite) :
    AccPt 0 (𝓟 (differenceSet A)) := by
  obtain ⟨x, hxA, hxacc⟩ :=
    hAinf.exists_accPt_of_subset_isCompact hAcompact (Subset.rfl)
  let f : UnitAddCircle → UnitAddCircle := fun y => y - x
  have hfinj : Function.Injective f := by
    intro a b hab
    simpa [f] using congrArg (fun z : UnitAddCircle => z + x) hab
  have hfcont : ContinuousAt f x := continuousAt_id.sub continuousAt_const
  have hmap := hxacc.map hfcont hfinj
  have hmap' : AccPt 0 (𝓟 (f '' A)) := by
    simpa [f] using hmap
  rw [accPt_iff_nhds] at hmap' ⊢
  intro U hU
  obtain ⟨y, ⟨hyU, hyImage⟩, hyne⟩ := hmap' U hU
  refine ⟨y, ⟨hyU, ?_⟩, hyne⟩
  rcases hyImage with ⟨z, hzA, rfl⟩
  exact ⟨(z, x), ⟨hzA, hxA⟩, rfl⟩

theorem rationalCirclePoint_sub {x y : UnitAddCircle}
    (hx : IsRationalCirclePoint x) (hy : IsRationalCirclePoint y) :
    IsRationalCirclePoint (x - y) := by
  rcases hx with ⟨qx, rfl⟩
  rcases hy with ⟨qy, rfl⟩
  refine ⟨qx - qy, ?_⟩
  change (((((qx - qy : ℚ) : ℝ)) : UnitAddCircle)) =
    (((qx : ℝ) : UnitAddCircle) - ((qy : ℝ) : UnitAddCircle))
  rw [Rat.cast_sub, AddCircle.coe_sub]

/-- The circle contains an explicit non-rational point. -/
theorem sqrtTwo_not_rationalCirclePoint :
    ¬ IsRationalCirclePoint ((Real.sqrt 2 : ℝ) : UnitAddCircle) := by
  rintro ⟨q, hq⟩
  have hzero : ((((q : ℝ) - Real.sqrt 2 : ℝ)) : UnitAddCircle) = 0 := by
    rw [AddCircle.coe_sub, hq]
    simp
  obtain ⟨z, hz⟩ :=
    (AddCircle.coe_eq_zero_iff (p := (1 : ℝ))).mp hzero
  apply irrational_sqrt_two
  refine ⟨q - (z : ℚ), ?_⟩
  simp only [Rat.cast_sub, Rat.cast_intCast]
  have hzreal : (z : ℝ) = (q : ℝ) - Real.sqrt 2 := by
    simpa [zsmul_eq_mul] using hz
  linarith

theorem limitingCore_all_rational
    (hF : FurstenbergSourcePremise) (w : List (Fin 10)) (hw : w ≠ []) :
    ∀ x ∈ limitingCore w, IsRationalCirclePoint x := by
  intro x hx
  rcases hF.orbit_dense_or_rational x with hrat | hdense
  · exact hrat
  · exfalso
    have horbit : tenSixteenOrbit x ⊆ limitingCore w := by
      rintro y ⟨s, t, rfl⟩
      have ht : circleMul (16 ^ t) x ∈ limitingCore w := by
        induction t with
        | zero => simpa [circleMul] using hx
        | succ t iht =>
            have hnext := limitingCore_timesSixteen_mapsTo w iht
            change circleMul 16 (circleMul (16 ^ t) x) ∈ limitingCore w at hnext
            simpa [circleMul_comp, pow_succ, Nat.mul_comm, Nat.mul_assoc] using hnext
      have hs : circleMul (10 ^ s) (circleMul (16 ^ t) x) ∈ limitingCore w := by
        induction s with
        | zero => simpa [circleMul] using ht
        | succ s ihs =>
            have hnext := limitingCore_timesTen_mapsTo w ihs
            change circleMul 10 (circleMul (10 ^ s)
              (circleMul (16 ^ t) x)) ∈ limitingCore w at hnext
            simpa [circleMul_comp, pow_succ, Nat.mul_comm, Nat.mul_assoc] using hnext
      simpa [circleMul_comp] using hs
    have hclosure : closure (tenSixteenOrbit x) ⊆ limitingCore w :=
      closure_minimal horbit (limitingCore_isClosed w)
    have hfull : limitingCore w = Set.univ := by
      apply Set.eq_univ_of_univ_subset
      rw [← hdense.closure_eq]
      exact hclosure
    exact limitingCore_ne_univ w hw hfull

/-- Conditional only on the displayed source premise, the compact limiting
core of each fixed nonempty word is finite. The empty limit is allowed. -/
theorem limitingCore_finite
    (hF : FurstenbergSourcePremise) (w : List (Fin 10)) (hw : w ≠ []) :
    (limitingCore w).Finite := by
  by_contra hnot
  have hinf : (limitingCore w).Infinite := hnot
  have hDcompact := differenceSet_isCompact (limitingCore_isCompact w)
  have hDfull : differenceSet (limitingCore w) = Set.univ :=
    hF.zero_accumulation_forces_univ _ hDcompact.isClosed
      (differenceSet_timesTen_mapsTo (limitingCore_timesTen_mapsTo w))
      (differenceSet_timesSixteen_mapsTo (limitingCore_timesSixteen_mapsTo w))
      (zero_accPt_differenceSet_of_infinite_compact
        (limitingCore_isCompact w) hinf)
  have hsqrt : ((Real.sqrt 2 : ℝ) : UnitAddCircle) ∈
      differenceSet (limitingCore w) := by rw [hDfull]; trivial
  rcases hsqrt with ⟨⟨x, y⟩, ⟨hx, hy⟩, hxy⟩
  apply sqrtTwo_not_rationalCirclePoint
  rw [← hxy]
  exact rationalCirclePoint_sub
    (limitingCore_all_rational hF w hw x hx)
    (limitingCore_all_rational hF w hw y hy)

/-! ## Positive-expansive stabilization -/

/-- Strict positive expansivity convention used by the stabilization theorem. -/
def PositivelyExpansive {X : Type*} [PseudoMetricSpace X]
    (f : X → X) (c : ℝ) : Prop :=
  0 < c ∧ ∀ x y : X,
    (∀ n : ℕ, dist ((f^[n]) x) ((f^[n]) y) < c) → x = y

/-- Nested compacta eventually enter every open neighborhood of their full
intersection. This includes an empty intersection and `U = ∅`. -/
theorem decreasing_compact_eventually_subset_open
    {X : Type*} [TopologicalSpace X]
    (K : ℕ → Set X) (hclosed : ∀ n, IsClosed (K n))
    (hcompact0 : IsCompact (K 0)) (hanti : Antitone K)
    {U : Set X} (hUopen : IsOpen U) (hlimU : (⋂ n, K n) ⊆ U) :
    ∃ N, K N ⊆ U := by
  by_contra hnone
  let L : ℕ → Set X := fun n => K n ∩ Uᶜ
  have hLnonempty : ∀ n, (L n).Nonempty := by
    intro n
    by_contra hempty
    apply hnone
    refine ⟨n, ?_⟩
    intro x hxK
    by_contra hxU
    exact hempty ⟨x, hxK, hxU⟩
  have hLclosed : ∀ n, IsClosed (L n) := fun n =>
    (hclosed n).inter hUopen.isClosed_compl
  have hLcompact0 : IsCompact (L 0) :=
    hcompact0.inter_right hUopen.isClosed_compl
  have hLsucc : ∀ n, L (n + 1) ⊆ L n := by
    intro n x hx
    exact ⟨hanti (Nat.le_succ n) hx.1, hx.2⟩
  obtain ⟨x, hx⟩ :=
    IsCompact.nonempty_iInter_of_sequence_nonempty_isCompact_isClosed
      L hLsucc hLnonempty hLcompact0 hLclosed
  have hx' : ∀ n : ℕ, x ∈ L n := by
    intro n
    exact hx (L n) ⟨n, rfl⟩
  have hxKall : ∀ n : ℕ, x ∈ K n := fun n => (hx' n).1
  have hxK : x ∈ ⋂ n, K n := by
    simpa only [Set.mem_iInter] using hxKall
  have hxU : x ∈ U := hlimU hxK
  exact (hx' 0).2 hxU

/-- A decreasing compact forward-invariant family with finite intersection
stabilizes under a positively expansive map. No injectivity or periodicity of
the map on the finite limit is assumed, so finite preperiodic limits and the
empty limit are included. -/
theorem finite_intersection_stabilizes_of_positivelyExpansive
    {X : Type*} [MetricSpace X]
    (f : X → X) (hf : Continuous f) (c : ℝ) (hexp : PositivelyExpansive f c)
    (K : ℕ → Set X) (hclosed : ∀ n, IsClosed (K n))
    (hcompact0 : IsCompact (K 0)) (hanti : Antitone K)
    (hinv : ∀ n, MapsTo f (K n) (K n))
    (hfinite : (⋂ n, K n).Finite) :
    ∃ N, ∀ R, N ≤ R → K R = ⋂ n, K n := by
  classical
  let F : Set X := ⋂ n, K n
  have hFsub (n : ℕ) : F ⊆ K n := by
    intro x hx
    exact hx (K n) ⟨n, rfl⟩
  have hFinv : MapsTo f F F := by
    intro x hx
    have hxall : ∀ n : ℕ, x ∈ K n := by
      intro n
      exact hFsub n hx
    have hout : ∀ n : ℕ, f x ∈ K n := fun n => hinv n (hxall n)
    simpa [F, Set.mem_iInter] using hout
  have finish {N : ℕ} (hNF : K N ⊆ F) :
      ∃ N, ∀ R, N ≤ R → K R = ⋂ n, K n := by
    refine ⟨N, ?_⟩
    intro R hNR
    have hRF : K R ⊆ F := (hanti hNR).trans hNF
    have hFR : F ⊆ K R := hFsub R
    simpa [F] using Set.Subset.antisymm hRF hFR
  by_cases hnontrivial : F.Nontrivial
  · have hFfinite : F.Finite := by simpa [F] using hfinite
    have hsep : 0 < F.infsep :=
      hFfinite.infsep_pos_iff_nontrivial.mpr hnontrivial
    let r : ℝ := min c (F.infsep / 3)
    have hrpos : 0 < r := by
      exact lt_min hexp.1 (div_pos hsep (by norm_num))
    have hrc : r ≤ c := min_le_left _ _
    have hrsep : r ≤ F.infsep / 3 := min_le_right _ _
    let U : Set X := ⋃ p : X, ⋃ (_hp : p ∈ F),
      Metric.ball p r ∩ f ⁻¹' Metric.ball (f p) (F.infsep / 3)
    have hUopen : IsOpen U := by
      apply isOpen_iUnion
      intro p
      apply isOpen_iUnion
      intro hp
      exact Metric.isOpen_ball.inter (Metric.isOpen_ball.preimage hf)
    have hFU : F ⊆ U := by
      intro p hp
      refine Set.mem_iUnion_of_mem p ?_
      refine Set.mem_iUnion_of_mem hp ?_
      exact ⟨Metric.mem_ball_self hrpos,
        Metric.mem_ball_self (div_pos hsep (by norm_num))⟩
    obtain ⟨N, hNU⟩ := decreasing_compact_eventually_subset_open
      K hclosed hcompact0 hanti hUopen (by simpa [F] using hFU)
    apply finish
    intro x hx
    have hiterK (n : ℕ) : (f^[n]) x ∈ K N :=
      (hinv N).iterate n hx
    have hpExists (n : ℕ) : ∃ p : X, p ∈ F ∧
        dist ((f^[n]) x) p < r ∧
        dist ((f^[n.succ]) x) (f p) < F.infsep / 3 := by
      have hu := hNU (hiterK n)
      rcases Set.mem_iUnion.mp hu with ⟨p, hpU⟩
      rcases Set.mem_iUnion.mp hpU with ⟨hp, hballs⟩
      refine ⟨p, hp, hballs.1, ?_⟩
      simpa [Function.iterate_succ_apply'] using hballs.2
    let p : ℕ → X := fun n => Classical.choose (hpExists n)
    have hpF (n : ℕ) : p n ∈ F := (Classical.choose_spec (hpExists n)).1
    have hxclose (n : ℕ) : dist ((f^[n]) x) (p n) < r :=
      (Classical.choose_spec (hpExists n)).2.1
    have hnextclose (n : ℕ) :
        dist ((f^[n.succ]) x) (f (p n)) < F.infsep / 3 :=
      (Classical.choose_spec (hpExists n)).2.2
    have hpstep (n : ℕ) : p n.succ = f (p n) := by
      by_contra hne
      have hsep_le : F.infsep ≤ dist (p n.succ) (f (p n)) :=
        Set.infsep_le_dist_of_mem (hpF n.succ) (hFinv (hpF n)) hne
      have htri : dist (p n.succ) (f (p n)) < F.infsep := by
        calc
          dist (p n.succ) (f (p n)) ≤
              dist (p n.succ) ((f^[n.succ]) x) +
                dist ((f^[n.succ]) x) (f (p n)) := dist_triangle _ _ _
          _ < r + F.infsep / 3 := by
            exact add_lt_add
              (by simpa [dist_comm] using hxclose n.succ)
              (hnextclose n)
          _ ≤ F.infsep / 3 + F.infsep / 3 := add_le_add hrsep le_rfl
          _ < F.infsep := by linarith
      exact (not_lt_of_ge hsep_le) htri
    have hpiterate (n : ℕ) : (f^[n]) (p 0) = p n := by
      induction n with
      | zero => rfl
      | succ n ih =>
          rw [Function.iterate_succ_apply', ih, hpstep]
    have hclose (n : ℕ) :
        dist ((f^[n]) x) ((f^[n]) (p 0)) < c := by
      rw [hpiterate]
      exact (hxclose n).trans_le hrc
    have hxp : x = p 0 := hexp.2 x (p 0) hclose
    rw [hxp]
    exact hpF 0
  · have hsubsingleton : F.Subsingleton := not_nontrivial_iff.mp hnontrivial
    let U : Set X := ⋃ p : X, ⋃ (_hp : p ∈ F), Metric.ball p c
    have hUopen : IsOpen U := by
      apply isOpen_iUnion
      intro p
      apply isOpen_iUnion
      intro hp
      exact Metric.isOpen_ball
    have hFU : F ⊆ U := by
      intro p hp
      refine Set.mem_iUnion_of_mem p ?_
      refine Set.mem_iUnion_of_mem hp ?_
      exact Metric.mem_ball_self hexp.1
    obtain ⟨N, hNU⟩ := decreasing_compact_eventually_subset_open
      K hclosed hcompact0 hanti hUopen (by simpa [F] using hFU)
    apply finish
    intro x hx
    have hxU := hNU hx
    rcases Set.mem_iUnion.mp hxU with ⟨p, hpU⟩
    rcases Set.mem_iUnion.mp hpU with ⟨hpF, hxpclose⟩
    have hpfixed : f p = p := hsubsingleton (hFinv hpF) hpF
    have hiterK (n : ℕ) : (f^[n]) x ∈ K N :=
      (hinv N).iterate n hx
    have hclose (n : ℕ) : dist ((f^[n]) x) ((f^[n]) p) < c := by
      have hu := hNU (hiterK n)
      rcases Set.mem_iUnion.mp hu with ⟨q, hqU⟩
      rcases Set.mem_iUnion.mp hqU with ⟨hqF, hqclose⟩
      have hqp : q = p := hsubsingleton hqF hpF
      rw [Function.iterate_fixed hpfixed n]
      simpa [Metric.mem_ball, hqp] using hqclose
    have : x = p := hexp.2 x p hclose
    rw [this]
    exact hpF

/-- Multiplication by ten on the circle is positively expansive with the
explicit strict constant `1/100`. -/
theorem iterate_timesTen (n : ℕ) (x : UnitAddCircle) :
    (timesTen^[n]) x = circleMul (10 ^ n) x := by
  induction n with
  | zero => simp [circleMul]
  | succ n ih =>
      rw [Function.iterate_succ_apply', ih]
      change circleMul 10 (circleMul (10 ^ n) x) = _
      rw [circleMul_comp]
      congr 1
      simp [pow_succ, Nat.mul_comm]

theorem timesTen_positivelyExpansive :
    PositivelyExpansive timesTen (1 / 100 : ℝ) := by
  constructor
  · norm_num
  · intro x y hclose
    by_contra hxy
    let δ := dist x y
    have hδpos : 0 < δ := by simpa [δ] using (dist_pos.mpr hxy)
    have hδsmall : δ < (1 / 100 : ℝ) := by
      simpa [δ] using hclose 0
    have hex : ∃ k : ℕ, (1 / 100 : ℝ) ≤ (10 : ℝ) ^ k * δ := by
      obtain ⟨k, hk⟩ := pow_unbounded_of_one_lt (R := ℝ) (y := (10 : ℝ))
        ((1 / 100 : ℝ) / δ) (by norm_num : (1 : ℝ) < 10)
      refine ⟨k, ?_⟩
      have hmul := mul_lt_mul_of_pos_right hk hδpos
      have heq : (1 / 100 : ℝ) / δ * δ = 1 / 100 := by field_simp
      linarith
    let k := Nat.find hex
    have hklower : (1 / 100 : ℝ) ≤ (10 : ℝ) ^ k * δ := Nat.find_spec hex
    have hkpos : 0 < k := by
      by_contra hkzero
      have : k = 0 := Nat.eq_zero_of_not_pos hkzero
      rw [this, pow_zero, one_mul] at hklower
      linarith
    have hkprev : (10 : ℝ) ^ (k - 1) * δ < 1 / 100 := by
      exact not_le.mp (Nat.find_min hex (by omega : k - 1 < k))
    have hkupper : (10 : ℝ) ^ k * δ < 1 / 10 := by
      have hkdecomp : k = (k - 1) + 1 := by omega
      rw [hkdecomp, pow_succ]
      nlinarith
    let r : ℝ := (AddCircle.equivIco (1 : ℝ) (-1 / 2) (x - y)).val
    have hrmem : r ∈ Set.Ico (-1 / 2 : ℝ) (-1 / 2 + 1) :=
      (AddCircle.equivIco (1 : ℝ) (-1 / 2) (x - y)).property
    have hrcoe : (r : UnitAddCircle) = x - y := by
      exact (AddCircle.coe_equivIco (p := (1 : ℝ)) (a := (-1 / 2 : ℝ))
        (y := x - y))
    have hrhalf : |r| ≤ (1 : ℝ) / 2 := by
      rw [abs_le]
      constructor <;> linarith [hrmem.1, hrmem.2]
    have hrnorm : ‖(r : UnitAddCircle)‖ = |r| :=
      (AddCircle.norm_coe_eq_abs_iff (1 : ℝ) (by norm_num)).2 (by
        simpa using hrhalf)
    have hrabs : |r| = δ := by
      rw [← hrnorm, hrcoe]
      exact (dist_eq_norm x y).symm
    have hscaledHalf : |((10 : ℝ) ^ k * r)| ≤ (1 : ℝ) / 2 := by
      rw [abs_mul, abs_of_nonneg (by positivity : 0 ≤ (10 : ℝ) ^ k), hrabs]
      linarith
    have hdist : dist ((timesTen^[k]) x) ((timesTen^[k]) y) =
        (10 : ℝ) ^ k * δ := by
      rw [iterate_timesTen, iterate_timesTen, dist_eq_norm]
      simp only [circleMul, ← nsmul_sub, ← hrcoe, ← AddCircle.coe_nsmul]
      rw [(AddCircle.norm_coe_eq_abs_iff (1 : ℝ) (by norm_num)).2 (by
        simpa [nsmul_eq_mul] using hscaledHalf)]
      simp only [nsmul_eq_mul, Nat.cast_pow, Nat.cast_ofNat]
      rw [abs_mul, abs_of_nonneg (by positivity : 0 ≤ (10 : ℝ) ^ k), hrabs]
    have := hclose k
    rw [hdist] at this
    exact (not_lt_of_ge hklower) this

/-- The source premise gives a word-dependent stabilization depth. -/
theorem exists_fixedWord_core_stabilization_depth
    (hF : FurstenbergSourcePremise) (w : List (Fin 10)) (hw : w ≠ []) :
    ∃ R₀ : ℕ, ∀ R, R₀ ≤ R →
      Core w R = limitingCore w ∧ (Core w R).Finite := by
  have hfinite : (⋂ R : ℕ, Core w R).Finite := by
    simpa [limitingCore] using limitingCore_finite hF w hw
  obtain ⟨R₀, hR₀⟩ :=
    finite_intersection_stabilizes_of_positivelyExpansive
      timesTen timesTen_continuous (1 / 100 : ℝ) timesTen_positivelyExpansive
      (Core w) (core_isClosed w) (core_isClosed w 0).isCompact
      (fun _ _ hle => core_antitone_radius w hle)
      (core_forward_timesTen_invariant w) hfinite
  refine ⟨R₀, ?_⟩
  intro R hR
  have heq := hR₀ R hR
  have heq' : Core w R = limitingCore w := by
    simpa [limitingCore] using heq
  exact ⟨heq', (limitingCore_finite hF w hw).subset heq'.subset⟩

/-! ## Exact T48/T46/T72 bridge -/

/-- T46's exact reachable/live simple-SCC conclusion forces T72's semantic
eventual periodicity for every internal hidden walk and every projection. -/
theorem liveSCCCriterion_implies_globalEveryInternalProjectionEventuallyPeriodic
    (G : DecimalFactorEntropy.T46LiveSCC.Graph)
    (hcriterion : G.LiveSCCCriterion)
    {A : Type*} (rho : G.Edge → A) :
    T72ProjectedPeriodicity.Graph.GlobalEveryInternalProjectionEventuallyPeriodic G rho := by
  classical
  intro q hqReach hqLive hqCyclic
  have hsimple := (hcriterion q hqReach hqLive hqCyclic).2
  intro v hv z hz
  obtain ⟨r, hrinf'⟩ :=
    Finite.exists_infinite_fiber (fun n : ℕ => (z n).src)
  have hrinf : ((fun n : ℕ => (z n).src) ⁻¹' {r}).Infinite :=
    Set.infinite_coe_iff.mp hrinf'
  obtain ⟨i, hi⟩ := hrinf.nonempty
  have hir : (z i).src = r := by simpa using hi
  obtain ⟨j, hj, hij⟩ := hrinf.exists_gt i
  have hjr : (z j).src = r := by simpa using hj
  let p := j - i
  have hp : 0 < p := Nat.sub_pos_of_lt hij
  let u : ℕ → G.Edge := fun n => z (i + n)
  have hu : G.IsInfiniteWalk r u := by
    simpa [u, hir] using G.infiniteWalk_tail hz.1 i
  have hustay : ∀ n, G.SameSCC q (u n).src := by
    intro n
    exact (hz.2 (i + n)).2.1
  have hup : (u p).src = r := by
    simp only [u, p]
    rw [Nat.add_sub_of_le hij.le, hjr]
  have hshift : G.IsInfiniteWalk r (fun n => u (p + n)) := by
    simpa [hup] using G.infiniteWalk_tail hu p
  have hshiftStay : ∀ n, G.SameSCC q ((fun n => u (p + n)) n).src :=
    fun n => hustay (p + n)
  have heq : u = fun n => u (p + n) :=
    infiniteWalk_eq_of_simpleSCC G hqReach hsimple hu hshift hustay hshiftStay
  refine ⟨i, p, hp, ?_⟩
  intro n
  have hn := congrArg rho (congrFun heq n)
  simpa [u, Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using hn.symm

/-- Finite endpoint-complete core implies the exact bounded primitive-phase
certificate of T72, not merely an informal eventual-periodicity condition. -/
theorem core_finite_implies_exact_T72_certificate
    (w : List (Fin 10)) (hw : w ≠ []) (R : ℕ)
    (hfinite : (Core w R).Finite) :
    T72ProjectedPeriodicity.Graph.GlobalPrimitivePhaseCriterion
      (carryKMPGraph w hw R)
      T72ProjectedPeriodicity.T48.coordinateZeroProjection := by
  apply
    (DecimalFactorEntropy.T72ProjectedPeriodicity.T48.endpointComplete_global_primitivePhase_iff_coordinateZeroEventuallyPeriodic
      w hw R).2
  exact liveSCCCriterion_implies_globalEveryInternalProjectionEventuallyPeriodic
    (carryKMPGraph w hw R)
    ((core_finite_iff_liveSCCCriterion w hw R).1 hfinite)
    T72ProjectedPeriodicity.T48.coordinateZeroProjection

/-- Final qualitative fixed-word theorem. The witness depth depends on the
literal word and no bound in terms of its length is asserted. -/
theorem exists_wordDependent_exact_T72_certificate
    (hF : FurstenbergSourcePremise) (w : List (Fin 10)) (hw : w ≠ []) :
    ∃ R : ℕ,
      T72ProjectedPeriodicity.Graph.GlobalPrimitivePhaseCriterion
        (carryKMPGraph w hw R)
        T72ProjectedPeriodicity.T48.coordinateZeroProjection := by
  obtain ⟨R, hR⟩ := exists_fixedWord_core_stabilization_depth hF w hw
  exact ⟨R, core_finite_implies_exact_T72_certificate w hw R (hR R le_rfl).2⟩

