import TheoryLib.PiPositiveDecimalFactorEntropy.T10T10ScaleAdaptiveOrbitFourier
import TheoryLib.PiPositiveDecimalFactorEntropy.T18T18FiniteCircleQuantization
import TheoryLib.PiPositiveDecimalFactorEntropy.T22T22QuantizedFejerEnergy

/-!
# T23: abstract finite-group separation for adaptive Fejer energy

Source: `problems/local/pi-positive-decimal-factor-entropy.txt`
SHA-256: `a70dd741b27595aeb3dfc902b5e201579fed6bae24e2191f58c5ac64a22939e6`

This file constructs an abstract family of finite `ZMod q` label multisets.
It is not the decimal orbit of pi, is not asserted to arise by quantizing that
orbit, and gives no evidence that canonical conjecture C1 fails.

The energy below is the literal finite-label form of T22's complete signed
Fejer band: frequencies satisfy `|h| < H` and have the exact triangular weight
`1 - |h| / H`.  The construction shows that growth after normalization by
`M^2` alone does not force a positive lower bound after normalization by
`H*M^2`.
-/

noncomputable section

open Finset Filter
open scoped BigOperators Topology

namespace DecimalFactorComplexity.AbstractSubgroupSeparation

open DecimalFactorComplexity.FejerSpectralCriterion
open DecimalFactorComplexity.FiniteCircleQuantization
open DecimalFactorComplexity.QuantizedFejerEnergy
open DecimalFactorComplexity.ScaleAdaptiveOrbitFourier
open DecimalFactorEntropy.FinitePrefixMultiplicityTransfer

/-- Decimal exponent used by the `r`-th member of the family. -/
def decimalExponent (r : ℕ) : ℕ := 2 * (r + 1)

/-- Size of the cyclic subgroup supporting the `r`-th multiset. -/
def subgroupSize (r : ℕ) : ℕ := 10 ^ (r + 1)

/-- Sample size. It is both `subgroupSize r ^ 2` and `10 ^ decimalExponent r`. -/
def sampleSize (r : ℕ) : ℕ := subgroupSize r * subgroupSize r

/-- T10's `k = 0` adaptive bandwidth, written without division. -/
def bandwidth (r : ℕ) : ℕ := subgroupSize r * (5 * 10 ^ r)

/-- Ambient modulus. The subgroup generator is `sampleSize r = q / subgroupSize r`. -/
def modulus (r : ℕ) : ℕ := sampleSize r * subgroupSize r

instance subgroupSize_neZero (r : ℕ) : NeZero (subgroupSize r) := by
  exact ⟨by simp [subgroupSize]⟩

instance modulus_neZero (r : ℕ) : NeZero (modulus r) := by
  exact ⟨by simp [modulus, sampleSize, subgroupSize]⟩

/-- The embedding of `Fin (subgroupSize r)` as the order-`subgroupSize r`
subgroup generated by `sampleSize r` in `ZMod (modulus r)`. -/
def subgroupPoint (r : ℕ) (a : Fin (subgroupSize r)) : ZMod (modulus r) :=
  (a.val * sampleSize r : ℕ)

/-- Every subgroup point is repeated once for each second coordinate. -/
def subgroupLabel (r : ℕ) (j : Fin (sampleSize r)) : ZMod (modulus r) :=
  subgroupPoint r (finProdFinEquiv.symm j).1

/-- The exact finite subgroup supporting the label multiset. -/
def subgroupSupport (r : ℕ) : Finset (ZMod (modulus r)) :=
  Finset.univ.image (subgroupPoint r)

/-- The actual additive subgroup generated by the step `sampleSize r`. -/
def labelSubgroup (r : ℕ) : AddSubgroup (ZMod (modulus r)) :=
  AddSubgroup.zmultiples (sampleSize r : ZMod (modulus r))

/-- The generated additive subgroup represented as a finite set. -/
noncomputable def labelSubgroupFinset (r : ℕ) : Finset (ZMod (modulus r)) := by
  classical
  exact Finset.univ.filter fun z => z ∈ labelSubgroup r

/-- Literal T22 Fejer energy for a finite `ZMod q` label multiset. -/
def labelFejerEnergy {M q : ℕ} [NeZero q] (label : Fin M → ZMod q)
    (H : ℕ) : ℝ :=
  ∑ h ∈ fejerFrequencies H,
    fejerWeight H h * ‖∑ j : Fin M, quantizedCharacter q h (label j)‖ ^ 2

/-- Literal expansion displaying T22's signed cutoff and exact weight
`1 - |h|/H` for arbitrary finite labels. -/
theorem labelFejerEnergy_eq_complete_band {M q : ℕ} [NeZero q]
    (label : Fin M → ZMod q) (H : ℕ) :
    labelFejerEnergy label H =
      ∑ h ∈ fejerFrequencies H,
        (1 - (h.natAbs : ℝ) / (H : ℝ)) *
          ‖∑ j : Fin M, quantizedCharacter q h (label j)‖ ^ 2 := by
  rfl

/-- On labels produced by T18's floor quantization, the finite-label energy is
definitionally T22's `quantizedFejerEnergy`. -/
theorem labelFejerEnergy_quantizedOrbit_eq_T22 {M : ℕ} (x : Fin M → ℝ)
    (H q : ℕ) [NeZero q] :
    labelFejerEnergy (quantizedOrbit x q) H = quantizedFejerEnergy x H q := by
  rfl

/-- Energy of the explicit subgroup-label family. -/
def subgroupEnergy (r : ℕ) : ℝ :=
  labelFejerEnergy (subgroupLabel r) (bandwidth r)

/-- All arithmetic identities, divisibility conditions, and T10's `k = 0`
bandwidth are exposed in one theorem. -/
theorem family_parameters (r : ℕ) :
    let n := decimalExponent r
    let D := subgroupSize r
    let M := sampleSize r
    let H := bandwidth r
    let q := modulus r
    n = 2 * (r + 1) ∧
      D = 10 ^ (r + 1) ∧
      M = 10 ^ n ∧
      M = D * D ∧
      H = adaptiveBandwidth M 0 ∧
      H = M / 2 ∧
      M = 2 * H ∧
      D ∣ H ∧ D ∣ M ∧ D ∣ q ∧ M ∣ q ∧
      q = M * D ∧ 2 * H < q := by
  dsimp [decimalExponent, subgroupSize, sampleSize, bandwidth, modulus,
    adaptiveBandwidth]
  have hD : 10 ^ (r + 1) = 2 * (5 * 10 ^ r) := by
    rw [pow_succ]
    ring
  have hMtwo :
      10 ^ (r + 1) * 10 ^ (r + 1) =
        2 * (10 ^ (r + 1) * (5 * 10 ^ r)) := by
    rw [hD]
    ring
  refine ⟨rfl, rfl, ?_, rfl, ?_, ?_, hMtwo, ?_, ?_, ?_, ?_, rfl, ?_⟩
  · rw [← pow_add]
    congr 1
    omega
  · rw [hMtwo]
    simp
  · rw [hMtwo]
    simp
  · exact ⟨5 * 10 ^ r, rfl⟩
  · exact ⟨10 ^ (r + 1), rfl⟩
  · exact ⟨10 ^ (r + 1) * 10 ^ (r + 1), by ring⟩
  · exact ⟨10 ^ (r + 1), rfl⟩
  · have hDlarge : 1 < 10 ^ (r + 1) := by
      exact one_lt_pow₀ (by norm_num) (by omega)
    have hMpos : 0 < 10 ^ (r + 1) * 10 ^ (r + 1) := by positivity
    rw [← hMtwo]
    nlinarith

/-- The displayed subgroup embedding is injective, so its support has the
claimed cardinality. -/
theorem subgroupPoint_injective (r : ℕ) : Function.Injective (subgroupPoint r) := by
  intro a b hab
  have hM : 0 < sampleSize r := by
    simp [sampleSize, subgroupSize]
  have ha : a.val * sampleSize r < modulus r := by
    simpa [modulus, Nat.mul_comm] using
      Nat.mul_lt_mul_of_pos_right a.isLt hM
  have hb : b.val * sampleSize r < modulus r := by
    simpa [modulus, Nat.mul_comm] using
      Nat.mul_lt_mul_of_pos_right b.isLt hM
  have hv := congrArg ZMod.val hab
  simp only [subgroupPoint, ZMod.val_natCast_of_lt ha,
    ZMod.val_natCast_of_lt hb] at hv
  exact Fin.ext (Nat.eq_of_mul_eq_mul_right hM hv)

/-- The supporting subgroup has exactly `subgroupSize r` elements. -/
theorem subgroupSupport_card (r : ℕ) :
    (subgroupSupport r).card = subgroupSize r := by
  classical
  rw [subgroupSupport,
    Finset.card_image_iff.mpr (subgroupPoint_injective r).injOn]
  simp

/-- The generated additive subgroup has the displayed subgroup size. -/
theorem labelSubgroup_card (r : ℕ) :
    Nat.card (labelSubgroup r) = subgroupSize r := by
  rw [labelSubgroup, Nat.card_zmultiples,
    ZMod.addOrderOf_coe (sampleSize r) (NeZero.ne (modulus r))]
  have hM : 0 < sampleSize r := by simp [sampleSize, subgroupSize]
  have hMdiv : sampleSize r ∣ modulus r := by
    exact ⟨subgroupSize r, rfl⟩
  rw [Nat.gcd_eq_right_iff_dvd.mpr hMdiv, modulus]
  simpa [Nat.mul_comm] using Nat.mul_div_left (subgroupSize r) hM

/-- The finite support used above is exactly the generated additive subgroup,
not merely a set of the right cardinality. -/
theorem subgroupSupport_eq_labelSubgroup_toFinset (r : ℕ) :
    subgroupSupport r = labelSubgroupFinset r := by
  classical
  apply Finset.eq_of_subset_of_card_le
  · intro z hz
    simp only [subgroupSupport, Finset.mem_image, Finset.mem_univ,
      true_and] at hz
    obtain ⟨a, rfl⟩ := hz
    simp only [labelSubgroupFinset, Finset.mem_filter, Finset.mem_univ,
      true_and]
    rw [labelSubgroup, AddSubgroup.mem_zmultiples_iff]
    refine ⟨(a.val : ℤ), ?_⟩
    unfold subgroupPoint
    push_cast
    simp [zsmul_eq_mul]
  · rw [subgroupSupport_card]
    rw [labelSubgroupFinset, ← Fintype.card_subtype]
    simpa only [Nat.card_eq_fintype_card] using (labelSubgroup_card r).le

/-- Every point in the supporting subgroup occurs with the exact multiplicity
`sampleSize r / subgroupSize r = subgroupSize r`. -/
theorem subgroupLabel_exact_multiplicity (r : ℕ) (a : Fin (subgroupSize r)) :
    prefixMultiplicity (subgroupLabel r) (subgroupPoint r a) =
      subgroupSize r := by
  classical
  unfold prefixMultiplicity
  rw [show subgroupSize r =
    (Finset.univ : Finset (Fin (subgroupSize r))).card by simp]
  change ((Finset.univ : Finset (Fin (sampleSize r))).filter
      (fun j => subgroupLabel r j = subgroupPoint r a)).card =
    (Finset.univ : Finset (Fin (subgroupSize r))).card
  refine Finset.card_bij
    (fun j _hj => (finProdFinEquiv.symm j).2) ?_ ?_ ?_
  · intro j hj
    simp
  · intro i hi j hj hij
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hi hj
    have hiFirst : (finProdFinEquiv.symm i).1 = a :=
      subgroupPoint_injective r (by simpa [subgroupLabel] using hi)
    have hjFirst : (finProdFinEquiv.symm j).1 = a :=
      subgroupPoint_injective r (by simpa [subgroupLabel] using hj)
    apply finProdFinEquiv.symm.injective
    exact Prod.ext (hiFirst.trans hjFirst.symm) hij
  · intro b hb
    refine ⟨finProdFinEquiv (a, b), ?_, ?_⟩
    · simp only [Finset.mem_filter, Finset.mem_univ, true_and, subgroupLabel]
      rw [Equiv.symm_apply_apply]
    · simp

/-- No label lies outside the displayed subgroup support. -/
theorem subgroupLabel_mem_support (r : ℕ) (j : Fin (sampleSize r)) :
    subgroupLabel r j ∈ subgroupSupport r := by
  classical
  simp [subgroupLabel, subgroupSupport]

/-- Exact multiplicity formula on every ambient residue, including residues
outside the subgroup. -/
theorem subgroupLabel_multiplicity_formula (r : ℕ) (z : ZMod (modulus r)) :
    prefixMultiplicity (subgroupLabel r) z =
      if z ∈ subgroupSupport r then subgroupSize r else 0 := by
  classical
  by_cases hz : z ∈ subgroupSupport r
  · rw [if_pos hz]
    simp only [subgroupSupport, Finset.mem_image, Finset.mem_univ,
      true_and] at hz
    obtain ⟨a, rfl⟩ := hz
    exact subgroupLabel_exact_multiplicity r a
  · rw [if_neg hz]
    unfold prefixMultiplicity
    rw [Finset.card_eq_zero]
    ext j
    simp only [Finset.mem_filter, Finset.mem_univ, true_and,
      Finset.notMem_empty, iff_false]
    intro hj
    apply hz
    rw [← hj]
    exact subgroupLabel_mem_support r j

/-- T18's strict aliasing condition holds for the complete T22 band. -/
theorem subgroupFamily_aliasFree (r : ℕ) :
    2 * bandwidth r < modulus r ∧
      Set.InjOn (quantizedCharacter (modulus r))
        {h : ℤ | h.natAbs < bandwidth r} := by
  refine ⟨(family_parameters r).2.2.2.2.2.2.2.2.2.2.2.2, ?_⟩
  exact lowFrequency_quantizedCharacter_injective
    (modulus r) (bandwidth r) (family_parameters r).2.2.2.2.2.2.2.2.2.2.2.2

/-- Restricting an ambient standard character to the displayed subgroup gives
the standard character with the same signed frequency on `ZMod D`. -/
theorem subgroupPoint_character (r : ℕ) (h : ℤ)
    (a : Fin (subgroupSize r)) :
    quantizedCharacter (modulus r) h (subgroupPoint r a) =
      quantizedCharacter (subgroupSize r) h (a.val : ZMod (subgroupSize r)) := by
  unfold quantizedCharacter subgroupPoint
  rw [AddChar.mulShift_apply, AddChar.mulShift_apply]
  rw [show ((a.val * sampleSize r : ℕ) : ZMod (modulus r)) =
      ((a.val : ℤ) * (sampleSize r : ℤ) : ℤ) by norm_cast]
  rw [show (a.val : ZMod (subgroupSize r)) = (a.val : ℤ) by norm_cast]
  rw [show (h : ZMod (modulus r)) *
      (((a.val : ℤ) * (sampleSize r : ℤ) : ℤ) : ZMod (modulus r)) =
        ((h * (a.val : ℤ) * (sampleSize r : ℤ) : ℤ) :
          ZMod (modulus r)) by
      push_cast
      ring]
  rw [show (h : ZMod (subgroupSize r)) *
      ((a.val : ℤ) : ZMod (subgroupSize r)) =
        ((h * (a.val : ℤ) : ℤ) : ZMod (subgroupSize r)) by
      push_cast
      ring]
  rw [ZMod.stdAddChar_coe, ZMod.stdAddChar_coe]
  congr 1
  push_cast
  field_simp [modulus, sampleSize, subgroupSize]
  rw [modulus]
  push_cast
  ring

/-- The canonical equivalence from `Fin D` to `ZMod D` is the natural cast. -/
theorem finEquiv_apply_eq_natCast (D : ℕ) [NeZero D] (a : Fin D) :
    (ZMod.finEquiv D).toEquiv a = (a.val : ZMod D) := by
  cases D with
  | zero => exact (NeZero.ne 0 rfl).elim
  | succ D =>
      apply Fin.ext
      change a.val = a.val % (D + 1)
      exact (Nat.mod_eq_of_lt a.isLt).symm

/-- Orthogonality of the standard character over the smaller cyclic group,
stated with the signed divisibility condition used by the family. -/
theorem sum_subgroupSize_character (r : ℕ) (h : ℤ) :
    (∑ a : Fin (subgroupSize r),
        quantizedCharacter (subgroupSize r) h
          (a.val : ZMod (subgroupSize r))) =
      if (subgroupSize r : ℤ) ∣ h then (subgroupSize r : ℂ) else 0 := by
  classical
  calc
    (∑ a : Fin (subgroupSize r),
        quantizedCharacter (subgroupSize r) h
          (a.val : ZMod (subgroupSize r))) =
        ∑ z : ZMod (subgroupSize r),
          quantizedCharacter (subgroupSize r) h z := by
      exact Fintype.sum_equiv (ZMod.finEquiv (subgroupSize r)).toEquiv
        _ _ (fun a => by rw [finEquiv_apply_eq_natCast])
    _ = if (h : ZMod (subgroupSize r)) = 0 then
          (subgroupSize r : ℂ) else 0 := by
      simpa [quantizedCharacter, mul_comm] using
        (AddChar.sum_mulShift (R' := ℂ)
          (h : ZMod (subgroupSize r))
          (ZMod.isPrimitive_stdAddChar (subgroupSize r)))
    _ = if (subgroupSize r : ℤ) ∣ h then
          (subgroupSize r : ℂ) else 0 := by
      simp only [ZMod.intCast_zmod_eq_zero_iff_dvd]

/-- The character sum of the repeated subgroup is `M` on its annihilator and
zero off it. -/
theorem subgroupLabel_character_sum (r : ℕ) (h : ℤ) :
    (∑ j : Fin (sampleSize r),
        quantizedCharacter (modulus r) h (subgroupLabel r j)) =
      if (subgroupSize r : ℤ) ∣ h then (sampleSize r : ℂ) else 0 := by
  classical
  change (∑ j : Fin (subgroupSize r * subgroupSize r),
      quantizedCharacter (modulus r) h
        (subgroupPoint r (finProdFinEquiv.symm j).1)) = _
  calc
    _ = ∑ p : Fin (subgroupSize r) × Fin (subgroupSize r),
        quantizedCharacter (modulus r) h (subgroupPoint r p.1) := by
      symm
      exact Fintype.sum_equiv finProdFinEquiv _ _ (fun p => by simp)
    _ = ∑ a : Fin (subgroupSize r), ∑ _b : Fin (subgroupSize r),
        quantizedCharacter (modulus r) h (subgroupPoint r a) := by
      rw [Fintype.sum_prod_type]
    _ = (subgroupSize r : ℂ) *
        ∑ a : Fin (subgroupSize r),
          quantizedCharacter (modulus r) h (subgroupPoint r a) := by
      simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin,
        nsmul_eq_mul, Finset.mul_sum]
    _ = (subgroupSize r : ℂ) *
        (if (subgroupSize r : ℤ) ∣ h then
          (subgroupSize r : ℂ) else 0) := by
      congr 1
      simp_rw [subgroupPoint_character]
      exact sum_subgroupSize_character r h
    _ = if (subgroupSize r : ℤ) ∣ h then (sampleSize r : ℂ) else 0 := by
      split_ifs <;> simp [sampleSize]

/-- The exact T22 triangular weights over a complete signed band sum to its
bandwidth. -/
theorem sum_fejerWeight (H : ℕ) (hH : 1 ≤ H) :
    (∑ h ∈ fejerFrequencies H, fejerWeight H h) = (H : ℝ) := by
  classical
  have hk : Theory.PiDigits.T27.fejerKernel (H - 1) 0 = (H : ℝ) := by
    unfold Theory.PiDigits.T27.fejerKernel Theory.PiDigits.T27.dirichletKernel
    rw [show H - 1 + 1 = H by omega]
    simp [Theory.PiDigits.T27.phase]
    rw [Nat.cast_sub hH]
    field_simp
    ring_nf
    exact mul_inv_cancel₀ (by positivity)
  apply Complex.ofReal_injective
  rw [← hk, Theory.PiDigits.BoundaryRobustFejerDichotomy.fejerKernel_eq_aggregated]
  push_cast
  apply Finset.sum_congr rfl
  intro h hh
  rw [triangularCoefficient_pred_eq_fejerWeight H h hH]
  simp [Theory.PiDigits.T27.phase]

/-- Dilating both the frequency and bandwidth by the subgroup size preserves
the exact triangular weight. -/
theorem fejerWeight_subgroup_multiple (r : ℕ) (m : ℤ) :
    fejerWeight (bandwidth r) ((subgroupSize r : ℤ) * m) =
      fejerWeight (5 * 10 ^ r) m := by
  unfold fejerWeight bandwidth
  rw [Int.natAbs_mul]
  simp
  have hD : (0 : ℝ) < subgroupSize r := by
    simp [subgroupSize]
  have hL : (0 : ℝ) < 5 * 10 ^ r := by positivity
  field_simp [hD.ne', hL.ne']

/-- The exact T22 weights sum to `H / D` over the annihilator frequencies. -/
theorem annihilator_fejerWeight_sum (r : ℕ) :
    (∑ h ∈ fejerFrequencies (bandwidth r),
        if (subgroupSize r : ℤ) ∣ h then fejerWeight (bandwidth r) h else 0) =
      (5 * 10 ^ r : ℕ) := by
  classical
  rw [← Finset.sum_filter]
  have hDpos : 0 < subgroupSize r := by simp [subgroupSize]
  have hLpos : 0 < 5 * 10 ^ r := by positivity
  have hHH : 1 ≤ bandwidth r := by
    rw [bandwidth]
    exact Nat.mul_pos hDpos hLpos
  have hHL : 1 ≤ 5 * 10 ^ r := hLpos
  calc
    (∑ h ∈ (fejerFrequencies (bandwidth r)).filter
        (fun h => (subgroupSize r : ℤ) ∣ h), fejerWeight (bandwidth r) h) =
        ∑ m ∈ fejerFrequencies (5 * 10 ^ r),
          fejerWeight (bandwidth r) ((subgroupSize r : ℤ) * m) := by
      symm
      apply Finset.sum_bij (fun m _hm => (subgroupSize r : ℤ) * m)
      · intro m hm
        simp only [Finset.mem_filter]
        constructor
        · rw [mem_fejerFrequencies_iff hHH]
          rw [Int.natAbs_mul]
          simp only [Int.natAbs_natCast, bandwidth]
          exact (Nat.mul_lt_mul_left hDpos).2
            ((mem_fejerFrequencies_iff hHL).mp hm)
        · exact dvd_mul_right _ _
      · intro a ha b hb hab
        exact mul_left_cancel₀ (by exact_mod_cast hDpos.ne') hab
      · intro h hh
        simp only [Finset.mem_filter] at hh
        obtain ⟨m, rfl⟩ := hh.2
        refine ⟨m, ?_, rfl⟩
        rw [mem_fejerFrequencies_iff hHL]
        have hhmul := (mem_fejerFrequencies_iff hHH).mp hh.1
        rw [Int.natAbs_mul, Int.natAbs_natCast] at hhmul
        exact (Nat.mul_lt_mul_left hDpos).mp (by simpa [bandwidth] using hhmul)
      · intro m hm
        rfl
    _ = ∑ m ∈ fejerFrequencies (5 * 10 ^ r),
          fejerWeight (5 * 10 ^ r) m := by
      apply Finset.sum_congr rfl
      intro m hm
      exact fejerWeight_subgroup_multiple r m
    _ = (5 * 10 ^ r : ℕ) := sum_fejerWeight _ hHL

/-- Exact energy evaluation for the explicit finite-group family. -/
theorem subgroupEnergy_exact (r : ℕ) :
    subgroupEnergy r =
      (sampleSize r : ℝ) ^ 2 * (5 * 10 ^ r : ℕ) := by
  classical
  unfold subgroupEnergy labelFejerEnergy
  calc
    (∑ h ∈ fejerFrequencies (bandwidth r),
        fejerWeight (bandwidth r) h *
          ‖∑ j : Fin (sampleSize r),
            quantizedCharacter (modulus r) h (subgroupLabel r j)‖ ^ 2) =
        (sampleSize r : ℝ) ^ 2 *
          ∑ h ∈ fejerFrequencies (bandwidth r),
            if (subgroupSize r : ℤ) ∣ h then
              fejerWeight (bandwidth r) h else 0 := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro h hh
      rw [subgroupLabel_character_sum]
      by_cases hd : (subgroupSize r : ℤ) ∣ h
      · rw [if_pos hd, if_pos hd]
        simp only [Complex.norm_natCast]
        ring
      · rw [if_neg hd, if_neg hd]
        simp
    _ = (sampleSize r : ℝ) ^ 2 * (5 * 10 ^ r : ℕ) := by
      rw [annihilator_fejerWeight_sum]

/-- Exact `M^2` normalization; this is the quantity that becomes unbounded. -/
theorem subgroupEnergy_div_sampleSize_sq (r : ℕ) :
    subgroupEnergy r / (sampleSize r : ℝ) ^ 2 = (5 : ℝ) * 10 ^ r := by
  rw [subgroupEnergy_exact]
  have hM : (sampleSize r : ℝ) ≠ 0 := by
    exact_mod_cast (by simp [sampleSize, subgroupSize] : sampleSize r ≠ 0)
  field_simp [hM]
  push_cast
  rfl

/-- Exact `H*M^2` normalization; the value is the reciprocal subgroup size. -/
theorem subgroupEnergy_div_bandwidth_sampleSize_sq (r : ℕ) :
    subgroupEnergy r /
        ((bandwidth r : ℝ) * (sampleSize r : ℝ) ^ 2) =
      (subgroupSize r : ℝ)⁻¹ := by
  rw [subgroupEnergy_exact]
  have hM : (sampleSize r : ℝ) ≠ 0 := by
    exact_mod_cast (by simp [sampleSize, subgroupSize] : sampleSize r ≠ 0)
  have hD : (subgroupSize r : ℝ) ≠ 0 := by
    exact_mod_cast (by simp [subgroupSize] : subgroupSize r ≠ 0)
  have hL : ((5 * 10 ^ r : ℕ) : ℝ) ≠ 0 := by
    exact_mod_cast (by positivity : (5 * 10 ^ r : ℕ) ≠ 0)
  rw [bandwidth]
  push_cast
  field_simp [hM, hD, hL]

/-- The energy divided by `M^2` is unbounded, with all family parameters and
conditions available from `family_parameters`. -/
theorem subgroupEnergy_normalized_unbounded :
    ∀ B : ℝ, ∃ r n M H q D : ℕ,
      n = decimalExponent r ∧ M = sampleSize r ∧ H = bandwidth r ∧
      q = modulus r ∧ D = subgroupSize r ∧
      M = 10 ^ n ∧ H = adaptiveBandwidth M 0 ∧
      D ∣ H ∧ D ∣ M ∧ D ∣ q ∧ M ∣ q ∧ 2 * H < q ∧
      B < subgroupEnergy r / (M : ℝ) ^ 2 := by
  intro B
  have ht : Tendsto (fun r : ℕ => (10 : ℝ) ^ r) atTop atTop :=
    tendsto_pow_atTop_atTop_of_one_lt (by norm_num)
  have hev : ∀ᶠ r : ℕ in atTop, B < (10 : ℝ) ^ r :=
    ht.eventually_gt_atTop B
  obtain ⟨r, hr⟩ := eventually_atTop.1 hev
  have hlarge : B < (5 : ℝ) * 10 ^ r := by
    have hr' := hr r le_rfl
    have hpow : (0 : ℝ) < 10 ^ r := by positivity
    nlinarith
  have hp := family_parameters r
  dsimp only at hp
  rcases hp with ⟨_hn, _hD, hMpow, _hMDD, hHadapt, _hHhalf,
    _hMtwo, hDH, hDM, hDq, hMq, _hq, halias⟩
  refine ⟨r, decimalExponent r, sampleSize r, bandwidth r, modulus r,
    subgroupSize r, rfl, rfl, rfl, rfl, rfl, hMpow, hHadapt,
    hDH, hDM, hDq, hMq, halias, ?_⟩
  rw [subgroupEnergy_div_sampleSize_sq]
  exact hlarge

/-- Despite the preceding unboundedness, the same energy divided by
`H*M^2` tends to zero. -/
theorem subgroupEnergy_density_tendsto_zero :
    Tendsto (fun r : ℕ =>
      subgroupEnergy r /
        ((bandwidth r : ℝ) * (sampleSize r : ℝ) ^ 2))
      atTop (𝓝 0) := by
  have ht : Tendsto (fun r : ℕ => ((1 : ℝ) / 10) ^ r) atTop (𝓝 0) :=
    tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num) (by norm_num)
  have heq :
      (fun r : ℕ =>
        subgroupEnergy r /
          ((bandwidth r : ℝ) * (sampleSize r : ℝ) ^ 2)) =
        fun r : ℕ => ((1 : ℝ) / 10) * ((1 : ℝ) / 10) ^ r := by
    funext r
    rw [subgroupEnergy_div_bandwidth_sampleSize_sq]
    unfold subgroupSize
    rw [pow_succ]
    push_cast
    have hp : (10 : ℝ) ^ r ≠ 0 := by positivity
    field_simp [hp]
    rw [← mul_pow]
    norm_num
  rw [heq]
  simpa using tendsto_const_nhds.mul ht

/-- Combined abstract separation. This conclusion contains no pi orbit and no
premise or conclusion about C1. -/
theorem abstract_finite_group_separation :
    (∀ B : ℝ, ∃ r : ℕ,
      B < subgroupEnergy r / (sampleSize r : ℝ) ^ 2) ∧
    Tendsto (fun r : ℕ =>
      subgroupEnergy r /
        ((bandwidth r : ℝ) * (sampleSize r : ℝ) ^ 2))
      atTop (𝓝 0) := by
  exact ⟨fun B => by
    obtain ⟨r, _n, _M, _H, _q, _D, _hn, hM, _hH, _hq, _hD,
        _hMpow, _hHadapt, _hDH, _hDM, _hDq, _hMq, _halias, hlarge⟩ :=
      subgroupEnergy_normalized_unbounded B
    exact ⟨r, by simpa [hM] using hlarge⟩,
    subgroupEnergy_density_tendsto_zero⟩

end DecimalFactorComplexity.AbstractSubgroupSeparation

