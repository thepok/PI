#!/usr/bin/env bash
# flash-prove v2 — cheap-model proof subroutine for builder sessions.
#
# Usage: flash-prove FILE.lean [--hints "lemma names"] [--model M] [--minutes N]
#
# FILE.lean must be a complete Lean file whose proof consists of exactly one
# bare `sorry` on its own line (the hole), compiling in the current lake
# workspace with only that sorry warning. Pipeline:
#   0. BASELINE GATE: `lake env lean FILE` must yield the sorry warning and no
#      errors. Aborts loudly otherwise — a broken baseline burned 20+ blind
#      attempts in production before this gate existed.
#   1. Deterministic closer ladder (zero model cost, ~10s each in a built
#      workspace): omega ring simp norm_num nlinarith positivity.
#   2. ONE agentic cheap-model session (default MiniMax M3, prepaid plan =
#      zero marginal cost; Marcel
#      2026-07-22: OpenRouter credits are reserved for experiments, so pass
#      --model openrouter/deepseek/deepseek-v4-flash only in experimental
#      runs): the model works inside the workspace with its tools and
#      iterates against `lake env lean` itself, capped at --minutes
#      (default 15). M3 fan-out is safe: 5 concurrent sessions verified.
#   3. INDEPENDENT VERIFICATION — nothing the model said is trusted:
#      diff-confinement (only the sorry line replaced; flash-prove-verify.py),
#      banned-construct scan on the inserted region, then our own clean
#      compile (no errors, no `declaration uses sorry`).
# On success: prints the winning body between BEGIN_BODY/END_BODY, leaves
# FILE.lean.solved next to the input, exit 0. On failure: exit 1, with the
# agent transcript preserved at FILE_agentic.lean.agentlog for escalation.
#
# History: v1 pasted the whole file into a blind one-shot prompt and pattern-
# matched a fenced block from the reply. Forensics on the two production
# failures showed that harness rejected correct proofs (restated-header false
# positives) and compiled against a broken baseline; the agentic condition
# solved both lemmas with the cheapest model in the fleet. Do not reintroduce
# blind attempts without the fixes documented in the 2026-07-22 analysis.
#
# Trust note: this tool is ADVISORY. Its output only ever enters research via
# an artifact that still passes independent review and the kernel/axiom gate.
set -u

FILE="${1:-}"; shift || true
HINTS=""; MODEL="minimax-coding-plan/MiniMax-M3"; MINUTES=15
while [[ $# -gt 0 ]]; do
  case "$1" in
    --hints) HINTS="$2"; shift 2;;
    --model) MODEL="$2"; shift 2;;
    --minutes) MINUTES="$2"; shift 2;;
    --attempts) shift 2;;  # v1 flag, ignored: v2 runs one agentic session
    *) echo "unknown arg $1" >&2; exit 2;;
  esac
done
[[ -f "$FILE" ]] || { echo "no such file: $FILE" >&2; exit 2; }
[[ -f lakefile.toml || -f lakefile.lean ]] || { echo "run from the lake workspace root" >&2; exit 2; }
[[ "$(grep -c '\bsorry\b' "$FILE")" == "1" ]] || { echo "exactly ONE sorry required" >&2; exit 2; }

SELF_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# lake must actually run: a missing binary exits 127 with "command not found",
# which contains no "error" — text-only checks pass vacuously (found live in
# the v2 smoke test, where every internal compile silently no-opped).
if ! command -v lake >/dev/null 2>&1; then
  [[ -d "$HOME/.elan/bin" ]] && export PATH="$HOME/.elan/bin:$PATH"
fi
command -v lake >/dev/null 2>&1 || { echo "FAIL: lake not on PATH" >&2; exit 2; }
WORK="$(mktemp -d "${TMPDIR:-/tmp}/flash-prove.XXXXXX")"
trap 'rm -rf "$WORK"' EXIT
START_TS=$(date +%s)

provelog() {  # $1 result  $2 mode  $3 model_attempts
  local elapsed=$(( $(date +%s) - START_TS ))
  local line
  line=$(python3 -c "import json,sys; print('PROVELOG ' + json.dumps({'file': sys.argv[1], 'result': sys.argv[2], 'mode': sys.argv[3], 'engine_model': sys.argv[4], 'model_attempts': int(sys.argv[5]), 'hints': sys.argv[6], 'elapsed_s': int(sys.argv[7]), 'ts': __import__('time').strftime('%Y-%m-%dT%H:%M:%SZ', __import__('time').gmtime())}))" "$FILE" "$1" "$2" "$MODEL" "$3" "${HINTS:-}" "$elapsed")
  echo "$line"
  # Durable log target: explicit override > pod record mount (/run) > sidecar.
  local target="${FLASH_PROVE_LOG:-}"
  if [[ -z "$target" && -w /run && ( -f /run/run_control.json || -f /run/orchestrator-input.json ) ]]; then
    target="/run/flash_prove.jsonl"
  fi
  [[ -z "$target" ]] && target="$FILE.provelog.jsonl"
  echo "${line#PROVELOG }" >> "$target" 2>/dev/null || true
}

# --- 0. baseline gate ---------------------------------------------------
BASE_OUT="$(lake env lean "$FILE" 2>&1)"
BASE_RC=$?
if [[ $BASE_RC -ne 0 ]] || printf '%s\n' "$BASE_OUT" | grep -qiE '(^|[^a-z])error'; then
  printf '%s\n' "$BASE_OUT" | head -20 >&2
  provelog "baseline-broken" "gate" 0
  echo "FAIL: baseline gate — FILE must compile with only the sorry warning." >&2
  echo "Fix the file (or build the workspace: lake build TheoryLib) before calling flash-prove." >&2
  exit 3
fi

try_body() {  # $1 = candidate body (single closer tactic)
  python3 - "$FILE" "$WORK/cand.lean" "$1" <<'PYEOF'
import sys
src, dst, body = sys.argv[1], sys.argv[2], sys.argv[3]
text = open(src).read()
text = text.replace("sorry", body, 1)
open(dst, "w").write(text)
PYEOF
  lake env lean "$WORK/cand.lean" >"$WORK/out.txt" 2>&1 \
    && ! grep -qE "declaration uses .?sorry" "$WORK/out.txt"
}

accept() {  # $1 label  $2 body  $3 mode  $4 attempts  $5 solved-file-src
  cp "$5" "$FILE.solved"
  provelog "$1" "$3" "$4"
  echo "SOLVED_BY: $1"
  echo "BEGIN_BODY"; printf '%s\n' "$2"; echo "END_BODY"
  exit 0
}

# --- 1. closer ladder ---------------------------------------------------
for closer in "omega" "ring" "simp" "norm_num" "nlinarith" "positivity"; do
  if try_body "$closer"; then
    accept "closer:$closer" "$closer" "closer" 0 "$WORK/cand.lean"
  fi
done

# --- 2. one agentic session --------------------------------------------
SORRY_LINE="$(grep -nE '^[[:space:]]*sorry[[:space:]]*$' "$FILE" | head -1 | cut -d: -f1)"
if [[ -z "$SORRY_LINE" ]]; then
  provelog "fail-no-bare-sorry" "agentic" 0
  echo "FAIL: closers exhausted and the sorry is not on its own line —" >&2
  echo "put the hole as a bare 'sorry' line to enable the agentic prover." >&2
  exit 1
fi
THEOREM="$(head -n "$SORRY_LINE" "$FILE" | grep -oE '^(theorem|lemma) [A-Za-z0-9_'\'']+' | tail -1 | awk '{print $2}')"
CAND="${FILE%.lean}_agentic.lean"
cp "$FILE" "$CAND"

PROMPT="You are a Lean 4 prover working inside an already-built lake workspace (Lean 4.30.0, mathlib v4.30.0). Work only inside this directory.

TASK: the file $CAND contains exactly one \`sorry\`, at line $SORRY_LINE, inside \`${THEOREM:-the target theorem}\`. Edit $CAND to replace that single sorry line with a correct proof block.

RULES:
- Work directly yourself: do NOT spawn subagents or explore-agents (a spawned subagent hung a session in testing).
- Change NOTHING except replacing that one sorry line: same theorem statement, same imports, no edits anywhere else in the file, no other files.
- Never use: sorry, admit, axiom, native_decide, exact?, apply?, rw?, simp?.
- The definitions and lemmas of this file and its local imports (TheoryLib.*) are available; read the file around line $SORRY_LINE first to learn the local API.
- Hint lemma names (unverified, may be wrong): ${HINTS:-none}. Confirm any mathlib name before using it, e.g. grep -rh 'theorem NAME' .lake/packages/mathlib/Mathlib --include='*.lean'.
- Compile check: \`lake env lean $CAND\` (takes ~10-60s). Iterate until it prints NO errors and NO 'declaration uses sorry' warning.
- Your edit is verified independently afterwards; claiming success without a clean compile counts as failure. If time is short, prefer a simple correct proof over an ambitious broken one."

# Keep the transcript: it is the escalation evidence on failure. Never
# discard the model call's output.
timeout "$((MINUTES * 60))" opencode run -m "$MODEL" "$PROMPT" > "$CAND.agentlog" 2>&1
AGENT_EXIT=$?

# --- 3. independent verification ---------------------------------------
if ! python3 "$SELF_DIR/flash-prove-verify.py" "$FILE" "$CAND" > "$CAND.body"; then
  cat "$CAND.body" >&2
  provelog "fail-verify" "agentic" 1
  echo "FAIL: patch verification rejected (agent exit $AGENT_EXIT)" >&2
  exit 1
fi
COMPILE_OUT="$(lake env lean "$CAND" 2>&1)"
COMPILE_RC=$?
if [[ $COMPILE_RC -ne 0 ]] || printf '%s\n' "$COMPILE_OUT" | grep -qE "error|declaration uses .?sorry"; then
  printf '%s\n' "$COMPILE_OUT" | head -20 >&2
  provelog "fail-compile" "agentic" 1
  echo "FAIL: candidate does not compile cleanly (agent exit $AGENT_EXIT)" >&2
  exit 1
fi
BODY="$(sed -n '/^BEGIN_BODY$/,/^END_BODY$/p' "$CAND.body" | sed '1d;$d')"
accept "agentic:$MODEL" "$BODY" "agentic" 1 "$CAND"
