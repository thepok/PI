ARG BASE_IMAGE=localhost/allmath-research:latest
FROM ${BASE_IMAGE}

ARG LEAN_AUDIT_TOOLCHAIN=leanprover/lean4:v4.31.0
ARG OPENCODE_VERSION=1.18.3

USER root

# Preserve the large cached Lean/mathlib base and update only the comparatively
# small research-tool environment. The repository and OpenCode auth stay
# runtime mounts and are deliberately not baked into this image.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends poppler-utils ripgrep; \
    rm -rf /var/lib/apt/lists/*; \
    pdftotext -v 2>&1 | grep -q 'pdftotext version'; \
    rg --version | grep -q 'ripgrep'

COPY requirements.txt /opt/allmath/requirements.txt

RUN set -eux; \
    python3 -m pip install --break-system-packages --no-cache-dir \
      -r /opt/allmath/requirements.txt; \
    python3 -c "import scipy"

# Add audit toolchains without rebuilding the large cached Mathlib layer. The
# project-local lean-toolchain file still selects the exact compiler per proof.
RUN set -eux; \
    elan toolchain install "${LEAN_AUDIT_TOOLCHAIN}"; \
    elan run "${LEAN_AUDIT_TOOLCHAIN}" lean --version | grep -F 'version 4.31.0'; \
    npm install -g --force "opencode-ai@${OPENCODE_VERSION}"; \
    test "$(opencode --version)" = "${OPENCODE_VERSION}"

ENV ALLMATH_AUDIT_LEAN_TOOLCHAIN="leanprover/lean4:v4.31.0"

LABEL org.opencontainers.image.title="pi-research" \
      org.opencontainers.image.description="Sandboxed Pi research environment with OpenCode, Lean, and numerical tooling."
