FROM localhost/opencodeworkflow-dev:latest

ARG KISSAT_REF=rel-4.0.3
ARG LEAN_TOOLCHAIN=leanprover/lean4:v4.30.0
ARG LEAN_AUDIT_TOOLCHAIN=leanprover/lean4:v4.31.0
ARG OPENCODE_VERSION=1.18.3

USER root

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      build-essential \
      cargo \
      ca-certificates \
      cmake \
      curl \
      elan \
      git \
      jq \
      libboost-graph-dev \
      libeigen3-dev \
      libflint-dev \
      libgmp-dev \
      libntl-dev \
      libopenblas-dev \
      nauty \
      ninja-build \
      pkg-config \
      poppler-utils \
      python3-pip \
      python3-venv \
      ripgrep \
      rustc; \
    rm -rf /var/lib/apt/lists/*

COPY lakefile.toml lake-manifest.json lean-toolchain /opt/allmath-lean/

RUN set -eux; \
    git clone --depth 1 --branch "${KISSAT_REF}" https://github.com/arminbiere/kissat.git /opt/kissat-src; \
    cd /opt/kissat-src; \
    ./configure; \
    make -j"$(nproc)"; \
    install -m 0755 build/kissat /usr/local/bin/kissat; \
    rm -rf /opt/kissat-src

RUN set -eux; \
    elan default "${LEAN_TOOLCHAIN}"; \
    elan toolchain install "${LEAN_AUDIT_TOOLCHAIN}"; \
    elan run "${LEAN_AUDIT_TOOLCHAIN}" lean --version; \
    elan run "${LEAN_AUDIT_TOOLCHAIN}" lake --version; \
    cd /opt/allmath-lean; \
    lake update; \
    lake exe cache get

RUN set -eux; \
    npm install -g --force "opencode-ai@${OPENCODE_VERSION}"; \
    test "$(opencode --version)" = "${OPENCODE_VERSION}"

COPY requirements.txt /opt/allmath/requirements.txt

RUN set -eux; \
    python3 -m pip install --break-system-packages --no-cache-dir --upgrade pip; \
    python3 -m pip install --break-system-packages --no-cache-dir -r /opt/allmath/requirements.txt; \
    ln -sf /usr/bin/python3 /usr/local/bin/python

ARG DRAT_TRIM_REF=v05.22.2023

RUN set -eux; \
    git clone --depth 1 --branch "${DRAT_TRIM_REF}" \
      https://github.com/marijnheule/drat-trim.git /opt/drat-trim-src; \
    make -C /opt/drat-trim-src -j"$(nproc)"; \
    install -m 0755 /opt/drat-trim-src/drat-trim /usr/local/bin/drat-trim; \
    rm -rf /opt/drat-trim-src

COPY workflows/runtime/containers/allmath-lean-gate.sh /tmp/allmath-lean-gate.sh

RUN set -eux; \
    install -m 0755 /tmp/allmath-lean-gate.sh /usr/local/bin/allmath-lean-gate; \
    rm -f /tmp/allmath-lean-gate.sh; \
    geng_path="$(command -v geng || command -v nauty-geng || true)"; \
    test -n "${geng_path}"; \
    if [ "${geng_path}" != /usr/local/bin/geng ]; then ln -sf "${geng_path}" /usr/local/bin/geng; fi; \
    lean --version; \
    lake --version; \
    g++ --version; \
    cargo --version; \
    pdftotext -v 2>&1 | grep -q 'pdftotext version'; \
    rg --version | grep -q 'ripgrep'; \
    printf '%s\n' '#include <flint/fmpz.h>' \
      'int main() { fmpz_t x; fmpz_init(x); fmpz_clear(x); }' \
      | g++ -x c++ - -lflint -lgmp -o /tmp/fastmath-flint-probe; \
    printf '%s\n' '#include <NTL/ZZ.h>' '#include <Eigen/Core>' '#include <cblas.h>' \
      'int main() { NTL::ZZ x(1); Eigen::Matrix2d m; m.setZero(); return x == 1 ? 0 : 1; }' \
      | g++ -x c++ - -I/usr/include/eigen3 -lntl -lgmp -lopenblas \
          -o /tmp/fastmath-math-probe; \
    /tmp/fastmath-flint-probe; \
    /tmp/fastmath-math-probe; \
    rm -f /tmp/fastmath-flint-probe /tmp/fastmath-math-probe; \
    kissat --version; \
    drat-trim 2>&1 | grep -q 'usage: drat-trim'; \
    geng -help >/dev/null 2>&1

ENV PATH="/root/.elan/bin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin" \
    ALLMATH_RESEARCH_POD=1 \
    ALLMATH_AUDIT_LEAN_TOOLCHAIN="leanprover/lean4:v4.31.0"

LABEL org.opencontainers.image.title="pi-research" \
      org.opencontainers.image.description="Sandboxed Pi research environment with OpenCode, Lean, numerical tools, and an isolated kernel verification gate."
